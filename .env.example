# Umgebungsvariablen — ausschließlich Namen, niemals Werte.
# Erhoben aus allen process.env[...]- und import.meta.env-Zugriffen im Code (Stand A2).

# --- Plattform (Lovable Cloud, automatisch bereitgestellt) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Jobs und Cron (plattformverwaltet) ---
# Einziges Job-Secret. Alle Endpunkte unter /api/public/jobs/* prüfen es.
LOVABLE_CRON_SECRET=
# Optional, nur während einer Rotation gesetzt (altes Secret bleibt kurzzeitig gültig).
LOVABLE_CRON_SECRET_PREVIOUS=

# --- AI Gateway ---
LOVABLE_API_KEY=

# --- Anwendung ---
# Basis-URL für Links in Kommunikation und Portal (z. B. https://beispiel.de)
APP_BASE_URL=

# --- Storefront-Referenz (Client) ---
VITE_COMMERCE_PUBLISHABLE_KEY=

# --- Zahlungen (aktuell BLOCKED, nicht gesetzt) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Kommunikations-Provider-Webhooks (aktuell BLOCKED, nicht gesetzt) ---
COMMUNICATION_WEBHOOK_SECRET=

# --- Dynamisch aufgelöste Secrets ---
# Ausgehende Automations-Webhooks (src/lib/commerce/automation/webhook.server.ts)
# und Carrier-Webhooks (src/routes/api/public/webhooks/carrier/$provider.ts)
# lesen den Variablennamen aus der Datenbank (secret_ref / secret_name).
# Namenskonvention für neue Einträge:
# AUTOMATION_WEBHOOK_SECRET_<NAME>=
# CARRIER_WEBHOOK_SECRET_<PROVIDER>=

# development | staging | production (Pflicht, fehlender Wert = sicherer Abbruch)
APP_ENV="development"

# --- Update Center (bei der Installation gesetzt; Vorgaben in installer/distribution/eyis-update-defaults.json) ---
EYIS_RELEASE_REPO="u-canboz/EYIS"
EYIS_UPDATE_REPO=
EYIS_UPDATE_HOSTING="lovable_sync"
EYIS_UPDATE_MIGRATIONS="enabled"
# Optional; sonst aus APP_BASE_URL abgeleitet.
EYIS_UPDATE_DEPLOY_HEALTH_URL=
# GitHub-Zugang: bevorzugt GitHub App, sonst mitgelieferter GitHub-Connector (GITHUB_API_KEY), sonst PAT.
EYIS_GITHUB_APP_ID=
EYIS_GITHUB_APP_INSTALLATION_ID=
EYIS_GITHUB_APP_PRIVATE_KEY=
EYIS_GITHUB_TOKEN=
GITHUB_API_KEY=
